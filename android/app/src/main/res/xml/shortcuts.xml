<?xml version="1.0" encoding="utf-8"?>
<!-- App shortcuts shown on long-press of the launcher icon. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="refresh"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_refresh"
        android:shortcutLongLabel="@string/shortcut_refresh_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.hyperscope.android"
            android:targetClass="com.hyperscope.android.MainActivity">
            <extra android:name="shortcut" android:value="refresh" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="control"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_control"
        android:shortcutLongLabel="@string/shortcut_control_long">
        <intent
            android:action="android.intent.action.MAIN"
            android:targetPackage="com.hyperscope.android"
            android:targetClass="com.hyperscope.android.MainActivity">
            <extra android:name="shortcut" android:value="control" />
        </intent>
    </shortcut>
</shortcuts>
